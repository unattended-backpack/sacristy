# Sacristy environment configuration.
#
# Copy to `.env` and fill in values:
#   cp .env.example .env

# --- L1 connection ---

# L1 execution layer RPC URL.
L1_RPC=http://localhost:8545

# Private key with ETH on L1 (used for deploying contracts).
ADMIN_PRIVATE_KEY=

# --- L2 accounts (private keys must be funded on L1) ---

# Batch submitter.
BATCHER_PRIVATE_KEY=

# Sequencer / unsafe block signer.
SEQUENCER_PRIVATE_KEY=
